# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CET 真题原始资料：2.2G 不入库，只入库 scripts/ 生成的题库
/data/CET46-Resources-main/
# CET 真题抽取缓存（LibreOffice 转 txt / OCR 结果）
data/.cache/

# Python 抽取脚本的字节码缓存，跟本地解释器版本绑定，入库只会污染 diff
__pycache__/
*.pyc
